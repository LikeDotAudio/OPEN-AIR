    "blocks": {
      "Frequency": {
        "type": "OcaBlock",
        "show_label": false,
        "description": {
          "En": "A block for managing center and span frequency settings.",
          "Fr": "Un bloc pour gérer les paramètres de fréquence centrale et d'intervalle.",
          "De": "Ein Block zur Verwaltung der Mittenfrequenz- und Spanneneinstellungen.",
          "Es": "Un bloque para gestionar los ajustes de frecuencia central e intervalo."
        },
        "fields": {
          "center_freq_MHz": {
            "label_active": {
              "En": "Center Frequency",
              "Fr": "Fréquence centrale",
              "De": "Mittenfrequenz",
              "Es": "Frecuencia central"
            },
            "type": "_Horizontal_with_dial_Value",
            "column_spacing": [
              10,
              10,
              10
            ],
            "layout": {
              "stretch": "width",
              "font": 20,
              "padx": 20,
              "width": "100%",
              "height": 140
            },
            "handler": "set_center_frequency",
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Center_Freq_MHz",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            },
            "locked": false,
            "default_value": "500",
            "min": "0",
            "max": "6000",
            "units": "MHz",
            "step_coarse": "1",
            "step_fine": "0.001",
            "step": ".001"
          },
          "span_freq_MHz": {
            "label_active": {
