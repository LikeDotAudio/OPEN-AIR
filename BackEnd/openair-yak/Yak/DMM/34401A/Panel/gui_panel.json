{
  "DMM_YAK_34401A_Panel": {
    "type": "OcaBin",
    "id": "50.100.4.10.1.0",
    "description": "Front-panel shaped commands — what a BUTTON can send",
    "blocks": {
      "Panel": {
        "type": "OcaBlock",
        "description": "Bare function-select and range commands for panel controls. The 2_CONFigure entries all carry <range>,<resolution> placeholders, which a mode toggle has no way to fill; these are the same functions with the meter left to autorange, which is what pressing VDC on the front panel does.",
        "fields": {
          "Function_Select": {
            "type": "OcaBlock",
            "description": "One command per measurement function",
            "fields": {
              "Select_DC_Volts": {
                "type": "OcaBlock",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:VOLTage:DC" }
                }
              },
              "Select_AC_Volts": {
                "type": "OcaBlock",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:VOLTage:AC" }
                }
              },
              "Select_DC_Current": {
                "type": "OcaBlock",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:CURRent:DC" }
                }
              },
              "Select_AC_Current": {
                "type": "OcaBlock",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:CURRent:AC" }
                }
              },
              "Select_Resistance_2W": {
                "type": "OcaBlock",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:RESistance" }
                }
              },
              "Select_Resistance_4W": {
                "type": "OcaBlock",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:FRESistance" }
                }
              },
              "Select_Continuity": {
                "type": "OcaBlock",
                "description": "Fixed 1 kOhm range, beeper on threshold — no range argument exists for this function",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:CONTinuity" }
                }
              },
              "Select_Diode": {
                "type": "OcaBlock",
                "description": "Fixed 1 mA / 1 V test, likewise argument-free",
                "fields": {
                  "Execute Command": { "type": "_GuiActuator", "message": ":CONFigure:DIODe" }
                }
              }
            }
          },
          "Ranging": {
            "type": "OcaBlock",
            "description": "SCOPED TO DC VOLTS on purpose: the 34401A has no function-agnostic autorange command, so :SENSe:VOLTage:DC:RANGe:AUTO is what a panel AUTO RANGE control can address. Selecting another function turns its own autorange on by default, which is why this is adequate for a bench panel and would not be for a test sequence.",
            "fields": {
              "Set_Autorange": {
                "type": "OcaBlock",
                "fields": {
                  "Execute Command": {
                    "type": "_GuiActuator",
                    "message": ":SENSe:VOLTage:DC:RANGe:AUTO <state>"
                  },
                  "Input": {
                    "type": "OcaBlock",
                    "fields": {
                      "state": { "value": "ON", "type": "_GuiValue", "label": "State", "units": "" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
