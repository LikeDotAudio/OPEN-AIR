{
  "model": "34401A",
  "family": "DMM",
  "set": {
    "Display_Text": {
      "scpi": ":DISPlay:TEXT <string>",
      "description": "Display Text",
      "group": "System Utilities",
      "args": [
        "string"
      ],
      "subsystem": "SYSTem"
    },
    "Enable_Math": {
      "scpi": ":CALCulate:STATe <state>",
      "description": "Enable Math",
      "group": "Math and Limits Setup",
      "args": [
        "state"
      ],
      "subsystem": "CALCulate"
    },
