        "axis": {
          "x": {
            "label": {
              "En": "Time (μs)",
              "Fr": "Temps (μs)",
              "De": "Zeit (μs)",
              "Es": "Tiempo (μs)"
            },
            "scale": "linear",
            "domain": {
              "min": 0,
              "max": 10
            },
            "color": "white"
          },
          "y": {
            "label": {
              "En": "Amplitude (V)",
              "Fr": "Amplitude (V)",
              "De": "Amplitude (V)",
              "Es": "Amplitud (V)"
            },
            "scale": "linear",
            "domain": {
