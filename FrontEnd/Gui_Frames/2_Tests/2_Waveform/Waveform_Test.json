{
  "Waveform_Test_Suite": {
    "type": "OcaBin",
    "description": {
      "En": "8-Channel Oscilloscope & Linked Multi-Oscillator Test Suite",
      "Fr": "Suite de tests d'oscilloscope 8 canaux et multi-oscillateurs liés",
      "De": "8-Kanal-Oszilloskop & verknüpfte Multi-Oszillator-Testsuite",
      "Es": "Suite de pruebas de osciloscopio de 8 canales y osciladores vinculados"
    },
    "behavior": {
      "fluid_ew": true,
      "overflow_ew": "auto",
      "overflow_ns": "auto",
      "scale_to_fit": false
    },
    "blocks": {
      "Test_Header": {
        "type": "OcaBlock",
        "label": {
          "active": {
            "text": {
              "En": "8-Channel Waveform Scan & Linked Oscillator Test Suite",
              "Fr": "Suite de tests de balayage de forme d'onde à 8 canaux et osc. liés",
              "De": "8-Kanal-Wellenformscan & verknüpfte Oszillator-Testsuite",
              "Es": "Suite de pruebas de exploración de forma de onda de 8 canales y osc. vinculados"
            },
            "text_size": 16,
            "text_color": "#00FFCC"
          }
        },
        "description": {
          "En": "Multi-channel linked oscillator signal generation and 8-channel synchronized waveform capture across configurable frequency scan ranges.",
          "Fr": "Génération de signal d'oscillateur lié multi-canal et capture de forme d'onde synchronisée à 8 canaux sur des plages de balayage de fréquence configurables.",
          "De": "Mehrkanalige verknüpfte Oszillator-Signalerzeugung und synchrone 8-Kanal-Wellenformerfassung über konfigurierbare Frequenz-Scanbereiche.",
          "Es": "Generación de señal de oscilador vinculado multicanal y captura de forma de onda sincronizada de 8 canales en rangos de exploración de frecuencia configurables."
        }
      },
      "Master_Scan_Controls": {
        "type": "OcaBlock",
        "label": {
          "active": {
            "text": {
              "En": "Master Sweep & Frequency Range Controls",
              "Fr": "Contrôles généraux de balayage et de plage de fréquence",
              "De": "Haupt-Sweep & Frequenzbereichssteuerung",
              "Es": "Controles maestros de barrido y rango de frecuencia"
            },
            "text_size": 13,
            "text_color": "#ffffff"
          }
        },
        "fields": {
          "start_freq_mhz": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Scan/StartFreqMHz",
            "label": {
              "active": {
                "text": {
                  "En": "Start Freq (MHz)"
                }
              }
            },
            "value": 1.0,
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "stop_freq_mhz": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Scan/StopFreqMHz",
            "label": {
              "active": {
                "text": {
                  "En": "Stop Freq (MHz)"
                }
              }
            },
            "value": 100.0,
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "sweep_step_mhz": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Scan/StepMHz",
            "label": {
              "active": {
                "text": {
                  "En": "Step Size (MHz)"
                }
              }
            },
            "value": 5.0,
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "sweep_mode": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Scan/SweepMode",
            "label": {
              "active": {
                "text": {
                  "En": "Linear Sweep"
                }
              }
            },
            "layout": {
              "width": 160,
              "height": 45
            }
          },
          "master_enable": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Scan/MasterEnable",
            "label": {
              "active": {
                "text": {
                  "En": "SWEEP RUNNING"
                }
              },
              "inactive": {
                "text": {
                  "En": "START FREQ SCAN"
                }
              }
            },
            "layout": {
              "width": 200,
              "height": 45
            }
          }
        }
      },
      "Linked_Oscillators_Panel": {
        "type": "OcaBlock",
        "label": {
          "active": {
            "text": {
              "En": "Linked Multi-Oscillator Signal Generator Array (OSC 1 - OSC 8)",
              "Fr": "Réseau de générateurs de signaux multi-oscillateurs liés (OSC 1 - OSC 8)",
              "De": "Verknüpftes Multi-Oszillator-Signalgenerator-Array (OSC 1 - OSC 8)",
              "Es": "Matriz de generadores de señales de osciladores múltiples vinculados (OSC 1 - OSC 8)"
            },
            "text_size": 13,
            "text_color": "#ffffff"
          }
        },
        "description": {
          "En": "Control linked oscillators: configure waveform shapes, base frequencies, amplitude levels, phase offsets, and tracking parameters.",
          "Fr": "Contrôlez les oscillateurs liés: configurez les formes d'onde, fréquences de base, niveaux d'amplitude, décalages de phase et paramètres de suivi.",
          "De": "Steuern Sie verknüpfte Oszillatoren: Konfigurieren Sie Wellenformen, Grundfrequenzen, Amplitudenpegel, Phasenverschiebungen und Tracking-Parameter.",
          "Es": "Controle osciladores vinculados: configure formas de onda, frecuencias base, niveles de amplitud, desfasajes y parámetros de seguimiento."
        },
        "fields": {
          "osc_master_link_toggle": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Oscillators/LinkAll",
            "label": {
              "active": {
                "text": {
                  "En": "LINKED TO FREQ SCAN"
                }
              },
              "inactive": {
                "text": {
                  "En": "INDEPENDENT MODE"
                }
              }
            },
            "layout": {
              "width": 220,
              "height": 45
            }
          },
          "osc1_wave_type": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Osc1/WaveType",
            "label": {
              "active": {
                "text": {
                  "En": "OSC 1: Sine (Ch 1/2)"
                }
              }
            },
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "osc2_wave_type": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Osc2/WaveType",
            "label": {
              "active": {
                "text": {
                  "En": "OSC 2: Square (Ch 3/4)"
                }
              }
            },
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "osc3_wave_type": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Osc3/WaveType",
            "label": {
              "active": {
                "text": {
                  "En": "OSC 3: Triangle (Ch 5/6)"
                }
              }
            },
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "osc4_wave_type": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Waveform/Osc4/WaveType",
            "label": {
              "active": {
                "text": {
                  "En": "OSC 4: Pulse / Modulation (Ch 7/8)"
                }
              }
            },
            "layout": {
              "width": 220,
              "height": 45
            }
          }
        }
      },
      "Oscillators_Config_Table": {
        "type": "OcaTable",
        "description": {
          "En": "Linked Oscillator Assignment & Parameter Matrix",
          "Fr": "Matrice d'assignation et de paramètres des oscillateurs liés",
          "De": "Zuordnungs- und Parametermatrix für verknüpfte Oszillatoren",
          "Es": "Matriz de asignación y parámetros de osciladores vinculados"
        },
        "topic": "OpenAir/Tests/Waveform/Oscillators/Matrix",
        "headers": ["osc_id", "assigned_channels", "waveform", "freq_multiplier", "base_amplitude_vp", "phase_offset_deg", "link_status"],
