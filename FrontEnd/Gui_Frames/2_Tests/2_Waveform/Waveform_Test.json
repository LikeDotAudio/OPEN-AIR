            "freq_multiplier": "1.0x (Modulated)",
            "base_amplitude_vp": "0.5 Vpp",
            "phase_offset_deg": "180.0°",
            "link_status": "LINKED_SCAN",
            "_row_state": "online"
          }
        ],
        "Sort": true
      },
      "8_Channel_Scope_Display": {
        "type": "DynamicGraph",
        "id": "oscilloscope_8ch_test_plot",
        "plot_mode": "time_domain",
        "title": "8-Channel Oscilloscope Real-Time Display (CH1 - CH8)",
        "layout": {
          "height": 550,
          "alpha": 0.95
