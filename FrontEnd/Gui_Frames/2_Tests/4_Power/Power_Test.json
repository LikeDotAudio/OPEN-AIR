{
  "Power_Test_Suite": {
    "type": "OcaBin",
    "description": {
      "En": "8-Channel Linked Power Supply & Dual DC Load Meter Test Suite",
      "Fr": "Suite de tests d'alimentation 8 canaux liés et de deux compteurs de charge DC",
      "De": "8-Kanal verknüpfte Stromversorgung & Duo DC-Lastmessgerät-Testsuite",
      "Es": "Suite de pruebas de fuente de alimentación vinculada de 8 canales y dos medidores de carga CC"
    },
    "behavior": {
      "fluid_ew": true,
      "overflow_ew": "auto",
      "overflow_ns": "auto",
      "scale_to_fit": false
    },
    "blocks": {
      "Test_Header": {
        "type": "OcaBlock",
        "label": {
          "active": {
            "text": {
              "En": "8-Channel Power Supply Array & Dual Electronic DC Load Test Suite",
              "Fr": "Réseau d'alimentations 8 canaux et suite de tests de charge DC électronique double",
              "De": "8-Kanal-Netzgerät-Array & Duo Elektronische DC-Last-Testsuite",
              "Es": "Matriz de fuentes de alimentación de 8 canales y suite de pruebas de carga CC electrónica dual"
            },
            "text_size": 16,
            "text_color": "#FFCC00"
          }
        },
        "description": {
          "En": "Gang and control 8 power supply units (PSUs) with linked voltage/current limits and live readouts, coupled with 2 Digital DC Electronic Load Meters.",
          "Fr": "Combinez et contrôlez 8 blocs d'alimentation (PSU) avec des limites de tension/courant liées et des lectures en direct, couplés à 2 compteurs de charge électronique DC numériques.",
          "De": "Koppeln und steuern Sie 8 Netzgeräte (PSUs) mit verknüpften Spannungs-/Strombegrenzungen und Live-Messwerten, gekoppelt mit 2 digitalen elektronischen DC-Lastmessgeräten.",
          "Es": "Agrupe y controle 8 fuentes de alimentación (PSU) con límites de voltaje/corriente vinculados y lecturas en vivo, junto con 2 medidores de carga electrónica CC digitales."
        }
      },
      "Master_PSU_Control_Panel": {
        "type": "OcaBlock",
        "label": {
          "active": {
            "text": {
              "En": "Master Linked PSU Array Controls & Global Max Limits",
              "Fr": "Contrôles généraux du réseau PSU lié et limites maximales globales",
              "De": "Haupt-PSU-Array-Steuerung & globale Höchstgrenzen",
              "Es": "Controles maestros del conjunto de PSU vinculadas y límites máximos globales"
            },
            "text_size": 13,
            "text_color": "#ffffff"
          }
        },
        "fields": {
          "psu_link_mode": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Power/Master/LinkMode",
            "label": {
              "active": {
                "text": {
                  "En": "ALL 8 PSUs LINKED (GANGED)"
                }
              },
              "inactive": {
                "text": {
                  "En": "INDIVIDUAL PSU CONTROL"
                }
              }
            },
            "layout": {
              "width": 240,
              "height": 45
            }
          },
          "master_voltage_max": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Power/Master/VoltageMax",
            "label": {
              "active": {
                "text": {
                  "En": "Master Max Voltage (V)"
                }
              }
            },
            "value": 24.0,
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "master_current_max": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Power/Master/CurrentMax",
            "label": {
              "active": {
                "text": {
                  "En": "Master Max Current (A)"
                }
              }
            },
            "value": 5.0,
            "layout": {
              "width": 180,
              "height": 45
            }
          },
          "psu_master_output_toggle": {
            "type": "_GuiActuator",
            "topic": "OpenAir/Tests/Power/Master/OutputToggle",
            "label": {
              "active": {
                "text": {
                  "En": "MASTER OUTPUT ON"
                }
              },
              "inactive": {
                "text": {
                  "En": "MASTER OUTPUT OFF"
                }
              }
            },
            "layout": {
              "width": 200,
              "height": 45
            }
          }
        }
      },
