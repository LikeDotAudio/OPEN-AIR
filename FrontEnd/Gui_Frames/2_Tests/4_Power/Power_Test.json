        "layout": {
          "height": 400,
          "alpha": 0.95
        },
        "axis": {
          "x": {
            "label": {
              "En": "Time (s)",
              "Fr": "Temps (s)",
              "De": "Zeit (s)",
              "Es": "Tiempo (s)"
            },
            "scale": "linear",
            "domain": {
              "min": 0,
              "max": 60
            },
            "color": "white"
          },
          "y": {
            "label": {
              "En": "Power (W) / Voltage (V)",
              "Fr": "Puissance (W) / Tension (V)",
              "De": "Leistung (W) / Spannung (V)",
              "Es": "Potencia (W) / Voltaje (V)"
            },
            "scale": "linear",
