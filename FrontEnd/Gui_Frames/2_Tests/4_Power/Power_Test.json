      "Dual_DC_Load_Meters": {
        "type": "OcaBlock",
        "label": {
          "active": {
            "text": {
              "En": "Dual Digital Electronic DC Load Meters (Load 1 & Load 2)",
              "Fr": "Double compteur de charge DC électronique numérique (Charge 1 & Charge 2)",
              "De": "Duo Digitale elektronische DC-Lastmessgeräte (Last 1 & Last 2)",
              "Es": "Dos medidores digitales de carga CC electrónica (Carga 1 y Carga 2)"
