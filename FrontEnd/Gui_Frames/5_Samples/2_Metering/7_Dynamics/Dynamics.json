{
  "Zoo_Metering_Dynamics": {
    "type": "OcaBin",
    "behavior": {
      "overflow_ns": "auto",
      "overflow_ew": "auto",
      "fluid_ew": true
    },
    "blocks": {
      "Dynamics_Demo": {
        "type": "OcaBlock",
        "description": {
          "En": "Dynamics Metering"
        },
        "fields": {
          "graph": {
            "type": "_AudioDynamics",
            "identity": {
              "label": "Stagebox Mic 53"
            },
            "geometry": {
              "width": 800,
              "height": 400
            },
            "datasets": [
              {
                "id": "curve",
                "initial_csv_data": "x,y\n-90,-90\n-40,-40\n-20,-20\n0,-12"
              }
            ],
            "command": "Dyn_Params"
          }
        }
      },
      "Dyn_Controls": {
        "type": "OcaBlock",
        "description": {
          "En": "Dynamics Controls"
        },
        "layout_columns": 6,
        "fields": {
          "Thresh": {
            "type": "_FaderKnob",
            "label": {
              "En": "Thresh"
            },
            "domain": {
              "primary": {
                "min": -60.0,
                "max": 0.0,
                "value_default": -20.0
              }
            },
            "layout": {
              "height": 200
            },
            "topic": "OpenAir/Gui/Dyn_Params/Thresh"
          },
          "Ratio": {
            "type": "_FaderKnob",
            "label": {
              "En": "Ratio"
            },
            "domain": {
              "primary": {
                "min": 1.0,
                "max": 20.0,
                "value_default": 2.0
              }
            },
            "layout": {
              "height": 200
            },
            "topic": "OpenAir/Gui/Dyn_Params/Ratio"
          },
          "Knee": {
            "type": "_FaderKnob",
            "label": {
              "En": "Knee"
            },
            "domain": {
              "primary": {
                "min": 0.0,
                "max": 30.0,
                "value_default": 5.0
              }
            },
            "layout": {
              "height": 200
            },
            "topic": "OpenAir/Gui/Dyn_Params/Knee"
          },
          "Gain": {
            "type": "_FaderKnob",
            "label": {
              "En": "Gain"
            },
            "domain": {
              "primary": {
                "min": -24.0,
                "max": 24.0,
                "value_default": 0.0
              }
            },
            "layout": {
              "height": 200
            },
            "topic": "OpenAir/Gui/Dyn_Params/Gain"
          },
          "Attack": {
            "type": "_FaderKnob",
            "label": {
              "En": "Attack"
            },
            "domain": {
              "primary": {
                "min": 0.1,
                "max": 100.0,
                "value_default": 10.0
              }
            },
            "layout": {
              "height": 200
            },
            "topic": "OpenAir/Gui/Dyn_Params/Attack"
          },
          "Release": {
            "type": "_FaderKnob",
            "label": {
              "En": "Release"
            },
            "domain": {
              "primary": {
                "min": 10.0,
                "max": 1000.0,
                "value_default": 100.0
              }
            },
            "layout": {
              "height": 200
            },
            "topic": "OpenAir/Gui/Dyn_Params/Release"
          }
        }
      }
    }
  }
} 
