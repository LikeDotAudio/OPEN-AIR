{
  "Zoo_Reverb": {
    "type": "OcaBin",
    "behavior": {
      "overflow_ns": "auto",
      "overflow_ew": "auto",
      "fluid_ew": true
    },
    "blocks": {
      "Reverb_Demo": {
        "type": "OcaBlock",
        "description": {
          "En": "Algorithmic Reverb Demo"
        },
        "layout_columns": 1,
        "fields": {
          "Reverb_Graph": {
            "type": "_Reverb",
            "label": {
              "En": "Master Bus Reverb — Impulse Response"
            },
            "topics": {
              "PreDelay": "OpenAir/Gui/Rev_Params/PreDelay",
              "Decay": "OpenAir/Gui/Rev_Params/Decay",
              "Diffusion": "OpenAir/Gui/Rev_Params/Diffusion",
              "Size": "OpenAir/Gui/Rev_Params/Size",
              "Damping": "OpenAir/Gui/Rev_Params/Damping",
              "Mix": "OpenAir/Gui/Rev_Params/Mix"
            },
            "channels": "mono",
            "fir_defaults": {
              "taps": 4096,
              "sample_rate": 48000,
              "phase": "minimum",
              "window": "hann"
            },
            "geometry": {
              "width": "100%",
              "height": 400
            }
          },
          "Reverb_Mode": {
            "type": "OcaBlock",
            "description": {
              "En": ""
            },
            "layout_columns": 1,
            "fields": {
              "Channels_Selector": {
                "type": "SelectorSwitch",
                "label": {
                  "En": "Channels"
                },
                "positions": [
                  "Mono",
                  "Stereo",
                  "5.1"
                ],
                "continuous": false,
                "value": {
                  "default_value": "Mono"
                },
                "indicator_color": "#f48a20",
                "shape": "circle",
                "pointer_style": "line",
                "layout": {
                  "width": 96,
                  "height": 96
                },
                "cosmetics": {
                  "colors": {
                    "primary": "#f48a20",
                    "secondary": "#444444",
                    "background": "#2b2b2b"
                  }
                },
                "topic": "OpenAir/Gui/Rev_Params/Channels"
              }
            }
          },
          "Reverb_Controls": {
            "type": "OcaBlock",
            "description": {
              "En": ""
            },
            "layout_columns": 6,
            "column_sizing": [
              { "weight": 1 },
              { "weight": 1 },
              { "weight": 1 },
              { "weight": 1 },
              { "weight": 1 },
              { "weight": 1 }
            ],
            "fields": {
              "PreDelay_Knob": {
                "type": "_Knob",
                "label": { "En": "Pre-Delay" },
                "domain": {
                  "primary": { "min": 0, "max": 200, "value_default": 20 }
                },
                "cosmetics": {
                  "visualization": "wbs-elma",
                  "colors": { "primary": "#546E7A", "cap": "#f48a20", "tick": "#aaaaaa" },
                  "styling": { "fill_color": "#546E7A", "cap_color": "#f48a20", "outline_color": "#000", "outline_thickness": 1 },
                  "flutes": 18,
                  "cap": { "show": true, "color": "#f48a20" },
                  "pointer_tip": { "show": true, "color": "#546E7A", "length": 0.2 },
                  "line": { "color": "#000" },
                  "scale": { "show": true, "style": "numeric", "count": 3, "length": 5, "thickness": 1 }
                },
                "layout": { "width": 64, "height": 64 },
                "topic": "OpenAir/Gui/Rev_Params/PreDelay"
              },
              "Decay_Knob": {
                "type": "_Knob",
                "label": { "En": "Decay (s)" },
                "domain": {
                  "primary": { "min": 0.1, "max": 10, "value_default": 1.8 }
                },
                "cosmetics": {
                  "visualization": "wbs-elma",
                  "colors": { "primary": "#546E7A", "cap": "#4CAF50", "tick": "#aaaaaa" },
                  "styling": { "fill_color": "#546E7A", "cap_color": "#4CAF50", "outline_color": "#000", "outline_thickness": 1 },
                  "flutes": 18,
                  "cap": { "show": true, "color": "#4CAF50" },
                  "pointer_tip": { "show": true, "color": "#546E7A", "length": 0.2 },
                  "line": { "color": "#000" },
                  "scale": { "show": true, "style": "numeric", "count": 3, "length": 5, "thickness": 1 }
                },
                "layout": { "width": 64, "height": 64 },
                "topic": "OpenAir/Gui/Rev_Params/Decay",
                "logarithmic": true
              },
              "Size_Knob": {
                "type": "_Knob",
                "label": { "En": "Size" },
                "domain": {
                  "primary": { "min": 0, "max": 1, "value_default": 0.5 }
                },
                "cosmetics": {
                  "visualization": "wbs-elma",
                  "colors": { "primary": "#546E7A", "cap": "#2196F3", "tick": "#aaaaaa" },
                  "styling": { "fill_color": "#546E7A", "cap_color": "#2196F3", "outline_color": "#000", "outline_thickness": 1 },
                  "flutes": 18,
                  "cap": { "show": true, "color": "#2196F3" },
                  "pointer_tip": { "show": true, "color": "#546E7A", "length": 0.2 },
                  "line": { "color": "#000" },
                  "scale": { "show": true, "style": "numeric", "count": 3, "length": 5, "thickness": 1 }
                },
                "layout": { "width": 64, "height": 64 },
                "topic": "OpenAir/Gui/Rev_Params/Size"
              },
              "Diffusion_Knob": {
                "type": "_Knob",
                "label": { "En": "Diffusion" },
                "domain": {
                  "primary": { "min": 0, "max": 1, "value_default": 0.7 }
                },
                "cosmetics": {
                  "visualization": "wbs-elma",
                  "colors": { "primary": "#546E7A", "cap": "#FFEB3B", "tick": "#aaaaaa" },
                  "styling": { "fill_color": "#546E7A", "cap_color": "#FFEB3B", "outline_color": "#000", "outline_thickness": 1 },
                  "flutes": 18,
                  "cap": { "show": true, "color": "#FFEB3B" },
                  "pointer_tip": { "show": true, "color": "#546E7A", "length": 0.2 },
                  "line": { "color": "#000" },
                  "scale": { "show": true, "style": "numeric", "count": 3, "length": 5, "thickness": 1 }
                },
                "layout": { "width": 64, "height": 64 },
                "topic": "OpenAir/Gui/Rev_Params/Diffusion"
              },
              "Damping_Knob": {
                "type": "_Knob",
                "label": { "En": "Damping" },
                "domain": {
                  "primary": { "min": 0, "max": 1, "value_default": 0.3 }
                },
                "cosmetics": {
                  "visualization": "wbs-elma",
                  "colors": { "primary": "#546E7A", "cap": "#F4902C", "tick": "#aaaaaa" },
                  "styling": { "fill_color": "#546E7A", "cap_color": "#F4902C", "outline_color": "#000", "outline_thickness": 1 },
                  "flutes": 18,
                  "cap": { "show": true, "color": "#F4902C" },
                  "pointer_tip": { "show": true, "color": "#546E7A", "length": 0.2 },
                  "line": { "color": "#000" },
                  "scale": { "show": true, "style": "numeric", "count": 3, "length": 5, "thickness": 1 }
                },
                "layout": { "width": 64, "height": 64 },
                "topic": "OpenAir/Gui/Rev_Params/Damping"
              },
              "Mix_Knob": {
                "type": "_Knob",
                "label": { "En": "Mix (%)" },
                "domain": {
                  "primary": { "min": 0, "max": 100, "value_default": 100 }
                },
                "cosmetics": {
                  "visualization": "wbs-elma",
                  "colors": { "primary": "#546E7A", "cap": "#F44336", "tick": "#aaaaaa" },
                  "styling": { "fill_color": "#546E7A", "cap_color": "#F44336", "outline_color": "#000", "outline_thickness": 1 },
                  "flutes": 18,
                  "cap": { "show": true, "color": "#F44336" },
                  "pointer_tip": { "show": true, "color": "#546E7A", "length": 0.2 },
                  "line": { "color": "#000" },
                  "scale": { "show": true, "style": "numeric", "count": 3, "length": 5, "thickness": 1 }
                },
                "layout": { "width": 64, "height": 64 },
                "topic": "OpenAir/Gui/Rev_Params/Mix"
              }
            }
          }
        }
      }
    }
  }
}
