{
  "Spectrum_Instrument_frequency": {
    "type": "OcaBin",
    "id": "50.100.0.3.1",
    "geometry": {
      "anchor": "NSEW"
    },
    "behavior": {
      "overflow_ns": "auto",
      "overflow_ew": "auto",
      "fluid_ew": false
    },
    "blocks": {
      "Frequency": {
        "type": "OcaBlock",
        "description": {
          "En": "A block for managing center and span frequency settings.",
          "Fr": "Un bloc pour gérer les paramètres de fréquence centrale et d'intervalle.",
          "De": "Ein Block zur Verwaltung der Mittenfrequenz- und Spanneneinstellungen.",
          "Es": "Un bloque para gestionar los ajustes de frecuencia central e intervalo.",
          "show_label": false
        },
        "fields": {
          "center_freq_MHz": {
            "label": {
              "active": {
                "En": "Center Frequency",
                "Fr": "Fréquence centrale",
                "De": "Mittenfrequenz",
                "Es": "Frecuencia central"
              },
              "show_label": false
            },
            "type": "_Horizontal_with_dial_Value",
            "layout": {
              "stretch": "width",
              "font": 10,
              "padx": 20,
              "width": "100%",
              "height": 140,
              "column_spacing": [
                60,
                10,
                15
              ]
            },
            "handler": "set_center_frequency",
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Center_Freq_MHz",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            },
            "domain": {
              "locked": false,
              "min": "0",
              "max": "6000",
              "units": "MHz",
              "step_coarse": "1",
              "step_fine": "0.001",
              "precision": ".001"
            },
            "value": {
              "default_value": "500"
            }
          },
          "span_freq_MHz": {
            "label": {
              "active": {
                "En": "Frequency Span",
                "Fr": "Fréquence Span",
                "De": "Frequenz Span",
                "Es": "Frecuencia Span"
              },
              "inactive": {
                "En": "Frequency Span",
                "Fr": "Fréquence Span",
                "De": "Frequenz Span",
                "Es": "Frecuencia Span"
              },
              "show_label": false
            },
            "type": "_Horizontal_with_dial_Value",
            "layout": {
              "stretch": "width",
              "font": 20,
              "padx": 20,
              "width": "100%",
              "height": 140,
              "column_spacing": [
                60,
                10,
                15
              ]
            },
            "handler": "set_span_frequency",
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Span_Frequency",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            },
            "domain": {
              "locked": false,
              "min": "0",
              "max": "1000",
              "units": "MHz",
              "step_coarse": "1",
              "step_fine": "0.001",
              "precision": ".001"
            },
            "value": {
              "default_value": "200"
            }
          }
        }
      },
      "Fold_Start_Stop": {
        "type": "OcaFold",
        "layout": {
          "pady": 5,
          "stretch": "width"
        }
      },
      "Start Stop": {
