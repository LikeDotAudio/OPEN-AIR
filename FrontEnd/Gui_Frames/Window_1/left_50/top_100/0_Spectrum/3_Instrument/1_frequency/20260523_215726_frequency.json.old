              "inactive": {
                "En": "Stop Frequency",
                "Fr": "Fréquence de fin",
                "De": "Stoppfrequenz",
                "Es": "Frecuencia de parada"
              },
              "show_label": false
            },
            "type": "_Horizontal_with_dial_Value",
            "layout": {
              "stretch": "width",
              "font": 20,
              "padx": 20,
              "width": "100%",
              "height": 140,
              "column_spacing": [
                60,
                10,
                15
              ]
            },
            "handler": "set_stop_frequency",
