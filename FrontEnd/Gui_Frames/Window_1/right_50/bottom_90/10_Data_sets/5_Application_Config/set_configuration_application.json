{
  "Information": {
    "type": "OcaBlock",
    "AES70": "OcaApplicationManager",
    "description": {
      "En": "A block for managing and displaying high-level application settings.",
      "Fr": "Un bloc pour gérer et afficher les paramètres d'application de haut niveau.",
      "De": "Ein Block zum Verwalten und Anzeigen von Anwendungseinstellungen auf hoher Ebene.",
      "Es": "Un bloque para gestionar y mostrar los ajustes de la aplicación de alto nivel."
    },
    "fields": {
      "Active": {
        "type": "_GuiButtonToggle",
        "label": {
          "En": "EngineGuiDisplay Active",
          "Fr": "EngineGuiDisplay active",
          "De": "Anwendung aktiv",
          "Es": "Aplicación activa"
        },
        "AES70": "OcaBooleanActuator",
        "handler": "set_application_active",
        "style": {
          "active": {
            "font_style": "bold",
            "font_size": null,
            "text_color": "#FF902C",
            "bg_color": "#000000",
            "border_color": "#FF9900",
            "border_thickness": 2,
            "glow_intensity": 1.944
          },
          "inactive": {
            "font_style": "normal",
            "font_size": null,
            "text_color": "#888888",
            "bg_color": "#2b2b2b",
            "border_color": "#555555",
            "border_thickness": 2,
            "glow_intensity": 0
          }
        },
        "options": {
          "ON": {
            "label": {
              "En": "Active",
              "Fr": "Actif",
              "De": "Aktiv",
              "Es": "Activo"
            },
            "selected": true
          },
          "OFF": {
            "label": {
              "En": "Inactive",
              "Fr": "Inactif",
              "De": "Inaktiv",
              "Es": "Inactivo"
            },
            "selected": false
          }
        }
      },
      "geometry": {
        "type": "_Label",
        "domain": {
          "units": null
        },
        "label": {
          "En": "Window Geometry",
          "Fr": "Window Geometry",
          "De": "Window Geometry",
          "Es": "Window Geometry"
        },
        "AES70": "OcaStringSensor"
      },
      "window_state": {
        "type": "_Label",
        "domain": {
          "units": null
        },
        "label": {
          "En": "Window State",
          "Fr": "État de fenêtre",
          "De": "Fensterstatus",
          "Es": "Estado de ventana"
        },
        "AES70": "OcaStringSensor"
      },
      "last_config_save_time": {
        "type": "_Label",
        "domain": {
          "units": null
        },
        "label": {
          "En": "Last Config Save Time",
          "Fr": "Last Config Enregistrer Temps",
          "De": "Last Config Speichern Zeit",
          "Es": "Last Config Guardar Tiempo"
        },
        "AES70": "OcaStringSensor"
      },
      "paned_window_sash_position_percentage": {
        "type": "_sliderValue",
        "domain": {
          "min": "0",
          "max": "100",
          "units": "%",
          "precision": "1"
        },
        "label": {
          "En": "Paned Window Sash Position",
          "Fr": "Paned Window Sash Position",
          "De": "Paned Window Sash Position",
          "Es": "Paned Window Sash Position"
        },
        "AES70": "OcaFloat32Actuator",
        "handler": "set_sash_position"
      }
    }
  },
