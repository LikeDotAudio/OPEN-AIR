    "Set_Autorange": {
      "scpi": ":SENSe:VOLTage:DC:RANGe:AUTO <state>",
      "scpiFast": ":SENS:VOLT:DC:RANG:AUTO <state>",
      "description": "Set Autorange",
      "arg": {
        "kind": "bool",
        "values": [
          "OFF",
          "ON"
        ]
      },
      "group": "SCOPED TO DC VOLTS on purpose: the 34401A has no function-agnostic autorange command, so :SENSe:VOLTage:DC:RANGe:AUTO is what a panel AUTO RANGE control can address. Selecting another function turns its own autorange on by default, which is why this is adequate for a bench panel and would not be for a test sequence.",
      "args": [
        "state"
      ],
      "subsystem": "Panel"
    },
