          "OFF",
          "ON"
        ]
      },
      "group": "Math and Limits Setup",
      "args": [
        "state"
      ],
      "subsystem": "CALCulate"
    },
    "Set_AC_Bandwidth": {
      "scpi": ":SENSe:VOLTage:AC:BANDwidth <filter>",
      "scpiFast": ":SENS:VOLT:AC:BAND <filter>",
      "description": "Set AC Bandwidth",
      "arg": {
        "kind": "numeric",
        "unit": "V",
