        "kind": "unknown",
        "default": "1000 HZ"
      },
      "args": [
        "value"
      ],
      "subsystem": "AMPL",
      "unverified": true
    },
    "Set_Ampl_Ext": {
      "scpi": "AMPLitude:EXTernal <value>",
      "scpiFast": "AMPL:EXT <value>",
      "description": "Selects glide or step settling in external sweep mode",
      "arg": {
        "kind": "bool",
        "values": [
          "OFF",
          "ON"
        ],
        "default": "GLIDE"
      },
      "args": [
        "value"
      ],
      "subsystem": "AMPL",
      "unverified": true
    },
    "Set_Ampl_Filt": {
      "scpi": "AMPLitude:FILTer <value>",
      "scpiFast": "AMPL:FILT <value>",
      "description": "Selects the filter for the Amplitude function, identical to the front- panel selection",
