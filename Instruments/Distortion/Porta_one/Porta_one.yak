      },
      "args": [
        "value"
      ],
      "subsystem": "AMPL",
      "unverified": true
    },
    "Set_Ampl_Fmin": {
      "scpi": "AMPLitude:FMIN <value>",
      "scpiFast": "AMPL:FMIN <value>",
