{
  "model": "33210A",
  "family": "Generator",
  "set": {
    "Set_Am_Source": {
      "scpi": "AM:SOUR <value>",
      "description": "AM Commands",
      "arg": {
        "kind": "enum",
        "values": [
          "INT",
          "EXT"
        ]
      },
      "args": [
        "value"
      ],
      "subsystem": "AM",
      "unverified": true
    },
    "Set_Am_State": {
      "scpi": "AM:STATe <value>",
      "scpiFast": "AM:STAT <value>",
      "description": "Set AM State",
      "arg": {
        "kind": "bool",
        "values": [
          "OFF",
          "ON"
        ]
      },
      "args": [
        "value"
      ],
      "group": "Modulation Control",
      "subsystem": "AM",
      "notes": "The two-way form of the pair `AM_State_ON` / `AM_State_OFF`, which stay for the momentary buttons that use them. A LATCHING control cannot drive a pair: one widget publishes one value to one command, so a AM switch bound to `AM_State_ON` could only ever turn AM on. Same bytes on the wire that `AM_State_ON` already proves the instrument accepts — only the keyword is a placeholder."
    },
    "Set_Amplitude": {
      "scpi": "VOLTage <amp>",
      "scpiFast": "VOLT <amp>",
