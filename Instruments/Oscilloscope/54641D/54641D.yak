    "channel_settings_1": {
      "scpi": ":CHANnel1:DISPlay?;:CHANnel1:SCALe?;:CHANnel1:OFFSet?",
      "scpiFast": ":CHAN1:DISP?;:CHAN1:SCAL?;:CHAN1:OFFS?",
      "description": "Channel 1: on/off, volts per division and offset in one round trip.",
      "subsystem": "CHANnel",
      "returns": {
        "count": 3,
        "separator": ";",
        "fields": [
          {
            "name": "state",
            "type": "BOOL"
          },
          {
            "name": "scale",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "offset",
            "type": "NR3",
            "unit": "V"
          }
        ]
      },
      "notes": "The channel index is IN THE COMMAND, not a parameter, so the reply lands on `Reading/channel_settings_1/scale` and a four-strip panel can tell its channels apart. A parameterised verb answers under one name whichever channel it read, which no per-channel display can bind to. Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    },
    "waveform_1": {
      "scpi": ":WAVeform:SOURce CHANnel1;:WAVeform:FORMat ASCii;:WAVeform:POINts 1000;:WAVeform:DATA?;:WAVeform:XORigin?;:WAVeform:XINCrement?",
      "scpiFast": ":WAV:SOUR CHAN1;:WAV:FORM ASC;:WAV:POIN 1000;:WAV:DATA?;:WAV:XOR?;:WAV:XINC?",
      "description": "Channel 1's trace, with the time axis it was captured on.",
      "subsystem": "WAVeform",
      "returns": {
        "count": 3,
        "separator": ";",
        "fields": [
          {
            "name": "samples",
            "type": "CSV",
            "unit": "V"
          },
          {
            "name": "xorigin",
            "type": "NR3",
            "unit": "s"
          },
          {
            "name": "xincrement",
            "type": "NR3",
            "unit": "s"
          }
        ]
      },
      "notes": "Samples ALONE cannot be plotted — the time axis rides in the same reply, because fetching it separately lets the two disagree when the timebase moves between reads. The source and format writes lead the queries in ONE message so the reply is the trace that was asked for. Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    },
    "measure_1": {
      "scpi": ":MEASure:SOURce CHANnel1;:MEASure:VPP?;:MEASure:VRMS?;:MEASure:FREQuency?",
      "scpiFast": ":MEAS:SOUR CHAN1;:MEAS:VPP?;:MEAS:VRMS?;:MEAS:FREQ?",
      "description": "Channel 1: Vpp, Vrms and frequency in one round trip.",
      "subsystem": "MEASure",
      "returns": {
        "count": 3,
        "separator": ";",
        "fields": [
          {
            "name": "vpp",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "vrms",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "freq",
            "type": "NR3",
            "unit": "Hz"
          }
        ]
      },
      "notes": "The 546xx measurement queries take their channel from :MEASure:SOURce, so that write leads them in the SAME message — set separately, another strip could move the source between the write and the read. No dB query exists on this firmware — the panel derives dBV from vrms. Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    },
