      "scpi": ":TIMebase:POSition <delay>",
      "scpiFast": ":TIM:POS <delay>",
      "description": "Horizontal delay — where the trigger sits in the captured window.",
      "arg": {
        "kind": "numeric",
        "unit": "s"
      },
      "args": [
        "delay"
      ],
      "group": "Horizontal Controls",
      "subsystem": "Time",
      "notes": "Agilent calls this the timebase POSition, Rigol the OFFSet. One name for one knob; `Set_Timebase_Position` remains as the instrument's own spelling. Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    },
    "Set_Math_Display": {
      "scpi": ":FUNCtion:DISPlay <state>",
      "scpiFast": ":FUNC:DISP <state>",
      "description": "Show or hide the math trace.",
      "arg": {
        "kind": "bool",
        "values": [
          "OFF",
          "ON"
        ]
      },
      "args": [
        "state"
      ],
      "group": "Math_FFT",
      "subsystem": "Math_FFT",
      "notes": "Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    },
    "Set_Math_Operator": {
      "scpi": ":FUNCtion:OPERation <value>",
      "scpiFast": ":FUNC:OPER <value>",
      "description": "The math operation.",
      "arg": {
        "kind": "enum",
        "values": [
          "ADD",
          "SUBT",
          "MULT",
          "DIFF",
          "INT",
          "FFT"
        ],
        "default": "SUBT"
      },
      "args": [
        "value"
      ],
      "group": "Math_FFT",
      "subsystem": "Math_FFT",
      "notes": "The name the DS1104Z already uses for the same control. Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    },
    "Set_Math_Scale": {
      "scpi": ":FUNCtion:RANGe <value>",
      "scpiFast": ":FUNC:RANG <value>",
      "description": "Vertical scale of the math result.",
      "arg": {
        "kind": "numeric",
        "unit": "V"
      },
      "args": [
        "value"
      ],
      "group": "Math_FFT",
      "subsystem": "Math_FFT",
      "notes": "Agilent's :FUNCtion:RANGe is FULL SCALE across the graticule where Rigol's :MATH:SCALe is per division — the same knob, eight divisions apart. `Set_Math_Range` remains as the instrument's own spelling. Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    }
  },
  "do": {
    "Auto_Scale": {
      "scpi": ":AUToscale",
      "scpiFast": ":AUT",
      "description": "Auto scale",
      "group": "Acquisition Control",
      "subsystem": "ROOT",
      "notes": "One panel button has to name ONE command, and the two scopes on this bench spelled autoscale differently — Autoscale here, Auto_Scale on the DS1104Z. Same `:AUToscale` this model's own Do_Autoscale already sends; the pair stays for anything referring to it by the old name."
    },
