        "kind": "enum",
        "values": [
          "20M",
          "OFF"
        ],
        "default": "OFF"
      },
      "group": "Channel 1 Vertical",
      "args": [
        "limit"
      ],
      "subsystem": "Channel_1"
    },
    "CH1_Coupling": {
