    "Get_Values": {
      "scpi": "MEAS:VOLT?;:MEAS:CURR?",
      "description": "Measured output voltage and current.",
      "group": "Readback Queries",
      "subsystem": "MEASure",
      "returns": {
        "count": 2,
        "separator": ";",
        "fields": [
          {
            "name": "voltage",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "current",
            "type": "NR3",
            "unit": "A"
          }
        ]
      },
      "notes": "Was `INST:NSEL <chan>;MEAS:VOLT?;MEAS:CURR?` — see the module docstring; it answered nothing here on either count. Verified on the 66101A at gpib7,30,0, 2026-08-08."
