  "rig": {
    "Set_Levels": {
      "scpi": "VOLT <voltage>;:CURR <current>",
      "description": "Voltage and current limit together, in one message.",
      "args": [
        "voltage",
        "current"
      ],
      "group": "Configuration",
      "subsystem": "SOURce",
      "notes": "Was `INST:NSEL <chan>;VOLT <volt>;CURR <curr>`, which answered nothing on this bench — the leading header does not exist on a module addressed at its own secondary address. This is the panel's SET button: the two sliders are its arguments, so a supply moves to a new operating point in ONE write rather than passing through the corner where the old limit meets the new voltage. Verified on the 66101A at gpib7,30,0, 2026-08-08."
    },
    "Set_Protection": {
      "scpi": "INST:NSEL <chan>;VOLT:PROT <ovp_level>;CURR:PROT:STAT <ocp_state>",
      "description": "Set Protection",
      "arg": {
        "kind": "unknown"
      },
      "group": "MPS Settings",
      "args": [
        "ovp_level",
        "ocp_state"
      ],
      "notes": "Undefined on a module addressed at its own GPIB secondary address, which is how all seven on this bench are wired — `SYST:ERR?` answers -113 after it, and it silently kills any reply chained behind it. Correct only for a mainframe addressed as one instrument. Checked 2026-08-08.",
      "unverified": true
    },
    "Set_S1_Levels": {
      "scpi": "INST:NSEL 1;VOLT <volt>;CURR <curr>",
      "description": "Set S1 Levels",
      "arg": {
        "kind": "unknown"
      },
      "group": "Configuration (Volts/Amps)",
      "args": [
        "volt",
        "curr"
      ],
      "notes": "Undefined on a module addressed at its own GPIB secondary address, which is how all seven on this bench are wired — `SYST:ERR?` answers -113 after it, and it silently kills any reply chained behind it. Correct only for a mainframe addressed as one instrument. Checked 2026-08-08.",
      "unverified": true
    },
    "Set_Voltage_Current": {
      "scpi": "INST:NSEL <chan>;VOLT <voltage>;CURR <current>",
      "description": "Set Voltage Current",
      "arg": {
        "kind": "unknown"
      },
      "group": "MPS Settings",
      "args": [
        "voltage",
        "current"
      ],
      "notes": "Undefined on a module addressed at its own GPIB secondary address, which is how all seven on this bench are wired — `SYST:ERR?` answers -113 after it, and it silently kills any reply chained behind it. Correct only for a mainframe addressed as one instrument. Checked 2026-08-08.",
      "unverified": true
    }
  },
