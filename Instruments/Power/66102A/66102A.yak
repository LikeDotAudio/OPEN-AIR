    "Set_Voltage": {
      "scpi": "VOLT <value>",
      "description": "Output voltage setpoint.",
      "arg": {
        "kind": "numeric",
        "unit": "V"
      },
      "args": [
        "value"
      ],
      "group": "Configuration",
      "subsystem": "SOURce",
      "notes": "No `INST:NSEL` — see the module docstring. Verified on the 66101A at gpib7,30,0, 2026-08-08."
    },
    "Set_Current": {
      "scpi": "CURR <value>",
      "description": "Current limit.",
      "arg": {
        "kind": "numeric",
        "unit": "A"
      },
      "args": [
        "value"
      ],
      "group": "Configuration",
      "subsystem": "SOURce",
      "notes": "The module holds this limit and drops into CC when it is reached, which is what `module_settings/oper_condition` bit 10 reports. Verified on the 66101A at gpib7,30,0, 2026-08-08."
    },
    "Set_Output": {
      "scpi": "OUTP <state>",
      "description": "Output on or off.",
      "arg": {
        "kind": "bool",
        "values": [
          "OFF",
          "ON"
        ]
      },
      "args": [
        "state"
      ],
      "group": "Output Control",
      "subsystem": "OUTPut",
      "notes": "`OUTP?` answers 1 or 0, so the panel's toggle is keyed 1/0 and sends what it reads back. Verified on the 66101A at gpib7,30,0, 2026-08-08."
    }
  },
  "do": {
    "Clear_Protection": {
      "scpi": "INST:NSEL <chan>;OUTP:PROT:CLE",
      "description": "Clear Protection",
      "group": "Output Control",
      "notes": "Undefined on a module addressed at its own GPIB secondary address, which is how all seven on this bench are wired — `SYST:ERR?` answers -113 after it, and it silently kills any reply chained behind it. Correct only for a mainframe addressed as one instrument. Checked 2026-08-08.",
      "unverified": true
    },
    "Clear_Status": {
      "scpi": "*CLS",
      "description": "Clear Status",
      "group": "Common Commands",
      "subsystem": "Common"
    },
