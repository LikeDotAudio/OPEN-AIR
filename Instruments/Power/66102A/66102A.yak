    "Read_Error": {
      "scpi": "SYST:ERR?",
      "description": "Read Error",
      "returns": {
        "count": 1,
        "type": "NR2"
      },
      "group": "System Utilities",
      "subsystem": "SYSTem"
    },
    "Read_Values": {
      "scpi": "INST:NSEL <chan>;MEAS:VOLT?;MEAS:CURR?",
      "description": "Read Voltage and Current",
      "returns": {
        "count": 2,
        "separator": ";",
        "fields": [
          {
            "name": "voltage",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "current",
            "type": "NR3",
            "unit": "A"
          }
        ]
      },
      "group": "MPS Metering",
      "notes": "Undefined on a module addressed at its own GPIB secondary address, which is how all seven on this bench are wired — `SYST:ERR?` answers -113 after it, and it silently kills any reply chained behind it. Correct only for a mainframe addressed as one instrument. Checked 2026-08-08.",
      "unverified": true
    },
    "module_settings": {
      "scpi": "VOLT?;:CURR?;:OUTP?;:MEAS:VOLT?;:MEAS:CURR?;:STAT:OPER:COND?",
      "description": "Everything the module was told and everything it reports, in one round trip.",
      "group": "Readback Queries",
      "subsystem": "MEASure",
      "returns": {
        "count": 6,
        "separator": ";",
        "fields": [
          {
            "name": "set_voltage",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "set_current",
            "type": "NR3",
            "unit": "A"
          },
          {
            "name": "output",
            "type": "BOOL"
          },
          {
            "name": "meas_voltage",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "meas_current",
            "type": "NR3",
            "unit": "A"
          },
          {
            "name": "oper_condition",
            "type": "NR1"
          }
        ]
      },
      "notes": "The panel's whole readback: every control on the module page names this as its `readback`, so ONE query after any write leaves nothing on screen that the instrument has not just confirmed.\n\noper_condition is the Operation Condition register. Bit 8 (256) is CV and bit 10 (1024) is CC — measured, not assumed: output on at 2 V into no load reads +256, and the same 2 V behind a 1 mA limit reads +1024 with MEAS:VOLT? collapsed to 0. Output off reads +0.\n\n`:STAT:QUES:COND?` is deliberately NOT chained on the end. It answers on its own and in a pair with :STAT:OPER:COND?, but appended to these six the whole reply is lost — and a chain that fails takes the five good values with it. Verified on the 66101A at gpib7,30,0, 2026-08-08."
    }
  }
}
