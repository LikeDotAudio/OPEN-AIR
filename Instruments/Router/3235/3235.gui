{
  "model": "3235",
  "manufacturer": "HP / Agilent / Keysight",
  "type": "Router",
  "notes": "High-perf Switching Matrix",
  "declared": {
    "resource": "TCPIP::44.44.44.222::gpib7,10::INSTR",
    "listen_only": true,
    "why": "The 3235 takes commands and answers none of them, so `*IDN?` returns nothing and no scan can find it. Declared here instead: the orchestrator adds it to the write map from this sheet, and the heartbeat leaves it alone rather than marking a working matrix unreachable once a minute. Verified 2026-08-08 — this resource accepts `OPEN 000-999` and replies with nothing, which is correct.",
    "on_connect": [
      "Open_All"
    ]
  },
  "channel_format": {
    "pattern": "SCC",
    "description": "One digit of slot then two of channel, so 705 is slot 7 channel 05. `OPEN`/`CLOSE` take a list or a range over the same numbering, which is what makes `OPEN 000-999` mean every relay in the frame."
  },
  "slots": {
    "4": {
      "channels": 24
    },
    "5": {
      "channels": 24
    },
    "6": {
      "channels": 24
    },
    "7": {
      "channels": 32
    },
    "8": {
      "channels": 20
    },
    "9": {
      "channels": 12
    }
  },
