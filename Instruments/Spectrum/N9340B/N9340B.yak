    "trace_settings": {
      "scpi": ":TRACe1:MODE?;:TRACe2:MODE?;:TRACe3:MODE?;:TRACe4:MODE?;:INITiate:CONTinuous?",
      "scpiFast": ":TRAC1:MODE?;:TRAC2:MODE?;:TRAC3:MODE?;:TRAC4:MODE?;:INIT:CONT?",
      "description": "Every trace mode plus the continuous-sweep state, in one round trip.",
      "subsystem": "Trace",
      "returns": {
        "count": 5,
        "separator": ";",
