{
  "model": "N9340B",
  "family": "Spectrum",
  "set": {
    "Set_Averaging": {
      "scpi": ":SENSe:AVERage:TRACe<trace_number>:COUNt <count_int>",
      "scpiFast": ":SENS:AVER:TRAC<trace_number>:COUN <count_int>",
      "description": "Trace averaging count.",
      "arg": {
        "kind": "numeric"
      },
      "args": [
        "count_int"
      ],
      "subsystem": "Trace",
      "notes": "The trace index sits in the MIDDLE: ':SENSe:AVERage:TRACe<n>:COUNt'. Eight spellings with it elsewhere — :TRACe:AVERage:COUNt, :SENSe:AVERage:COUNt, :AVERage:COUNt, :TRACe1:AVERage:COUNt and friends — all return -171 'Invalid expression', which is what made this look unsupported. Verified on CN03480580 2026-08-07: set 25 -> reads +25, set 100 -> reads +100."
    },
