            "handler": "toggle_preamp",
            "layout": {
              "height": 50,
              "stretch": "width",
              "font": 15
            },
            "style": {
              "active_text_color": "#1a1a1a",
              "text_color": "#888888",
              "active_font_style": "bold",
              "active_font_size": null,
              "inactive_font_style": "normal",
              "inactive_font_size": null,
              "active_color": "#FF9900",
              "active_bg_color": "#000000",
              "bg_color": "#2b2b2b",
              "glow_intensity": 1.944
