            "options": {
              "ON": {
                "label_active": "Preamp ON",
                "label_inactive": "Preamp ON",
                "selected": false
              },
              "OFF": {
                "label_active": "Preamp OFF",
                "label_inactive": "Preamp OFF",
                "selected": true
