{
  "Information": {
    "type": "OcaBlock",
    "AES70": "OcaApplicationManager",
    "description": "A block for managing and displaying high-level application settings.",
    "fields": {
      "Active": {
        "type": "_GuiButtonToggle",
        "label": "Application Active",
        "AES70": "OcaBooleanActuator",
        "handler": "set_application_active",
        "style": {
          "active_text_color": "#1a1a1a",
          "text_color": "#888888",
          "active_font_style": "bold",
          "active_font_size": null,
          "inactive_font_style": "normal",
          "inactive_font_size": null,
          "active_color": "#FF9900",
          "active_bg_color": "#000000",
          "bg_color": "#2b2b2b",
          "glow_intensity": 1.944
        },
        "options": {
          "ON": {
            "label": "Active",
            "selected": true
          },
          "OFF": {
            "label": "Inactive",
            "selected": false
          }
        }
      },
      "geometry": {
        "label": "Window Geometry",
        "type": "_Label",
        "AES70": "OcaStringSensor",
        "value": "1920x1127+1912+32",
        "units": null
      },
      "window_state": {
        "label": "Window State",
        "type": "_Label",
        "AES70": "OcaStringSensor",
        "value": "zoomed",
        "units": null
      },
      "last_config_save_time": {
        "label": "Last Config Save Time",
        "type": "_Label",
        "AES70": "OcaStringSensor",
        "value": "2025-08-23 21:33:40",
        "units": null
      },
      "paned_window_sash_position_percentage": {
        "label": "Paned Window Sash Position",
        "type": "_sliderValue",
        "AES70": "OcaFloat32Actuator",
        "handler": "set_sash_position",
        "value": "40",
        "min": "0",
        "max": "100",
        "step": "1",
        "units": "%"
      }
    }
  },
