': 'count', 'selected': False}, '75': {'label_active': 'Deep Dive', 'label_inactive': 'Deep Dive', 'description': "This setting is for serious analysis. It's a highly stable trace that filters out a large portion of the ambient RF noise, allowing for precise measurements of continuous signals.", 'value': '75', 'units': 'count', 'selected': False}, '100': {'label_active': 'Scientific Grade', 'label_inactive': 'Scientific Grade', 'description': 'For when only the cleanest signal will do. This high level of averaging provides a virtually noise-free display, perfect for scientific or very low-level signal detection.', 'value': '100', 'units': 'count', 'selected': False}, '200': {'label_active': 'Crystal Clear', 'label_inactive': 'Crystal Clear', 'description': 'A deep and thorough look at the spectrum. All but the most stable signals are averaged out, offering a truly pristine view of the fundamental RF environment.', 'value': '200', 'units': 'count', 'selected': False}, '500': {'label_active': 'The Observer', 'label_inactive': 'The Observer', 'description': 'An incredibly slow and deliberate pace. This is for long-term monitoring, allowing you to see the overall shape of the spectrum with almost all noise removed.', 'value': '500', 'units': 'count', 'selected': False}, '1000': {'label_active': 'Meditative Mode', 'label_inactive': 'Meditative Mode', 'description': 'For the patient and the meticulous. This is the ultimate level of noise reduction, yielding an exceptionally smooth and stable trace for the most demanding analysis.', 'value': '1000', 'units': 'count', 'selected': False}, 'UNSELECTED': {'value': 'NONE', 'label_active': 'None Selected', 'label_inactive': 'None Selected', 'description': 'No averaging option is currently selected.', 'units': '', 'selected': False}}, 'yak_handler': {'enable': True, 'yak_type': 'set', 'sub_path': 'Trace', 'command': 'Set_Averaging', 'input_name': 'count_int', 'converter': 'int'}, 'geometry': {'width': 126}, 'active_text_color': '