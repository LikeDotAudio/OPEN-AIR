{
  "right_top": {
    "type": "OcaBin",
    "id": "50.10",
    "description": "Root container locked to window edges with smart auto-scrolling.",
    "geometry": {
      "anchor": "NSEW"
    },
    "behavior": {
      "overflow_ns": "auto",
      "overflow_ew": "auto",
      "fluid_ew": true
    },
    "blocks": {
      "Control_Buttons": {
        "type": "OcaBlock",
        "fields": {
          "Start": {
            "type": "_GuiActuator",
            "label": "Start",
            "handler": "start_button_clicked",
            "layout": {
              "width": 80,
              "height": 40
            },
            "style": {
              "active_color": "#00ff00"
            }
          },
          "Pause": {
            "type": "_GuiButtonToggle",
            "label": "Pause",
            "handler": "pause_button_clicked",
            "layout": {
              "width": 80,
              "height": 40
            },
            "style": {
              "active_color": "#ffff00"
            }
          },
          "Stop": {
            "type": "_GuiActuator",
            "label": "Stop",
            "handler": "stop_button_clicked",
            "layout": {
              "width": 80,
              "height": 40
            },
            "style": {
              "active_color": "#ff0000"
            }
          }
        }
      }
    }
  }
}
