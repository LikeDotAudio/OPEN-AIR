{
  "Spectrum_Instrument_frequency": {
    "type": "OcaBin",
    "id": "50.100.0.3.1",
    "geometry": {
      "anchor": "NSEW"
    },
    "behavior": {
      "overflow_ns": "auto",
      "overflow_ew": "auto",
      "fluid_ew": true
    },
    "blocks": {
      "Frequency": {
        "type": "OcaBlock",
        "show_label": false,
        "description": "A block for managing center and span frequency settings.",
        "fields": {
          "center_freq_MHz": {
            "label_active": "Center Frequency",
            "type": "_Horizontal_with_dial_Value",
            "column_spacing": [
              80,
              10,
              10
            ],
            "layout": {
              "stretch": "width",
              "font": 20,
              "padx": 20
            },
            "handler": "set_center_frequency",
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Center_Freq_MHz",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            },
            "locked": false,
            "default_value": "500",
            "min": "0",
            "max": "6000",
            "units": "MHz",
            "step_coarse": "1",
            "step_fine": "0.001",
            "step": ".001"
          },
          "span_freq_MHz": {
            "label_active": "Frequency Span",
            "label_inactive": "Frequency Span",
            "type": "_Horizontal_with_dial_Value",
            "column_spacing": [
              80,
              10,
              10
            ],
            "layout": {
              "stretch": "width",
              "font": 20,
              "padx": 20
            },
            "handler": "set_span_frequency",
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Span_Frequency",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            },
            "locked": false,
            "default_value": "200",
            "min": "0",
            "max": "1000",
            "units": "MHz",
            "step_coarse": "1",
            "step_fine": "0.001",
            "step": ".001"
          }
        }
      },
      "Fold_Start_Stop": {
        "type": "OcaFold",
        "layout": {
          "pady": 5,
          "stretch": "width"
        }
      },
      "Start Stop": {
        "type": "OcaBlock",
        "show_label": false,
        "description": "A block for managing start and stop frequency settings.",
        "layout": {
          "weight": 0
        },
        "fields": {
          "start_freq_MHz": {
            "label_active": "Start Frequency",
            "label_inactive": "Start Frequency",
            "type": "_Horizontal_with_dial_Value",
            "column_spacing": [
              80,
              10,
              10
            ],
            "layout": {
              "stretch": "width",
              "font": 20,
              "padx": 20
            },
            "handler": "set_start_frequency",
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Start_Freq_MHz",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            },
            "locked": false,
            "default_value": "400",
            "min": "0",
            "max": "5999",
            "units": "MHz",
            "step_coarse": "1",
            "step_fine": "0.001",
            "step": ".001"
          },
          "stop_freq_MHz": {
            "label_active": "Stop Frequency",
            "label_inactive": "Stop Frequency",
            "type": "_Horizontal_with_dial_Value",
            "column_spacing": [
              80,
              10,
              10
            ],
            "layout": {
              "stretch": "width",
              "font": 20,
              "padx": 20
            },
            "handler": "set_stop_frequency",
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Stop_Freq_MHz",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            },
            "locked": false,
            "default_value": "600",
            "min": "1",
            "max": "6000",
            "units": "MHz",
            "step_coarse": "1",
            "step_fine": "0.001",
            "step": ".001"
          }
        }
      },
      "Fold_Presets": {
        "type": "OcaFold",
        "layout": {
          "pady": 5,
          "stretch": "width"
        }
      },
      "Quick Span": {
        "type": "OcaBlock",
        "description": "A block for managing all frequency-related presets.",
        "layout": {
          "weight": 0
        },
        "show_label": false,
        "fields": {
          "Span": {
            "type": "_GuiButtonToggler",
            "label_active": "Span",
            "AES70": "OcaSwitch",
            "handler": "set_span_frequency",
            "layout": {
              "height": 50,
              "max_cols": 4,
              "width": 160,
              "stretch": "width",
              "font": 11,
              "alpha": 0.9,
              "padx": 2,
              "pady": 2
            },
            "style": {
              "active_text_color": "#1a1a1a",
              "text_color": "#888888",
              "active_font_style": "bold",
              "active_font_size": null,
              "inactive_font_style": "normal",
              "inactive_font_size": null,
              "active_color": "#FF9900",
              "active_bg_color": "#000000",
              "bg_color": "#2b2b2b",
              "glow_intensity": 8
            },
            "options": {
              "1": {
                "value": "0.01",
                "label_active": "Microscope",
                "label_inactive": "Microscope",
                "description": "So tight you'll feel like a cellular biologist examining a single-cell waveform.",
                "units": "MHz",
                "selected": false
              },
              "2": {
                "value": "0.1",
                "label_active": "Tight",
                "label_inactive": "Tight",
                "description": "A narrow, focused view for getting up close and personal with signals.",
                "units": "MHz",
                "selected": false
              },
              "3": {
                "value": "1",
                "label_active": "Normal",
                "label_inactive": "Normal",
                "description": "The standard span, a balanced diet for most common analysis.",
                "units": "MHz",
                "selected": false
              },
              "4": {
                "value": "10",
                "label_active": "Wide",
                "label_inactive": "Wide",
                "description": "A broad, digestible view of the spectrum, great for general reconnaissance.",
                "units": "MHz",
                "selected": false
              },
              "5": {
                "value": "100",
                "label_active": "Ultra Wide",
                "label_inactive": "Ultra Wide",
                "description": "A very broad span for finding signals over a large frequency range. It's like scanning with a wide-angle lens.",
                "units": "MHz",
                "selected": false
              },
              "6": {
                "value": "500",
                "label_active": "From Space",
                "label_inactive": "From Space",
                "description": "A very broad span for finding signals over a large frequency range.",
                "units": "MHz",
                "selected": false
              },
              "7": {
                "value": "1000",
                "label_active": "From The Moon",
                "label_inactive": "From The Moon",
                "description": "A very broad span for finding signals over a large frequency range. It's like scanning with a wide-angle lens.",
                "units": "MHz",
                "selected": false
              },
              "UNSELECTED": {
                "value": "NONE",
                "label_active": "None Selected",
                "label_inactive": "None Selected",
                "description": "No span option is currently selected.",
                "units": "",
                "selected": true
              }
            },
            "yak_handler": {
              "enable": true,
              "yak_type": "set",
              "sub_path": "Frequency",
              "command": "Set_Span_Frequency",
              "input_name": "hz_value",
              "converter": "mhz_to_hz"
            }
          }
        }
      }
    }
  }
}