{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@contracts/*": ["../contracts/src/*"]
    }
  },
  "include": ["src/main.tsx", "src/boot.tsx", "src/globals.d.ts", "src/vite-env.d.ts", "scripts"]
}
